# .env.example — Practical 11
# Copy this file to .env in the same directory and fill in real values.
# This file is safe to commit. The actual .env is listed in .gitignore.

# ── MongoDB root credentials (used by docker-compose.yml) ────────────────────
# These are used to create the MongoDB admin user on first container start.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme

# ── JWT secret (used by the backend) ─────────────────────────────────────────
# Use a long random string. Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
