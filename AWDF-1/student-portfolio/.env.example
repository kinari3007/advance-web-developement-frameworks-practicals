# .env.example — Practical 11
# Copy this file to .env in the same directory and fill in REAL values.
# This file is safe to commit. The actual .env is listed in .gitignore.

# ── MongoDB container root credentials ───────────────────────────────────────
# These create the MongoDB admin user when the container starts for the first time.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme

# ── Backend MongoDB connection string ─────────────────────────────────────────
# IMPORTANT: use "taskmgr-mongodb" as the hostname (Docker Compose service name).
# Do NOT use "localhost" here — the backend container cannot reach MongoDB via localhost.
# Replace "admin" and "changeme" with your real MONGO_ROOT_USER and MONGO_ROOT_PASS.
# If the password contains @  :  /  ?  #  [ or ] — percent-encode those characters.
MONGO_URI=mongodb://admin:changeme@taskmgr-mongodb:27017/awdf_tasks?authSource=admin

# ── JWT secret ────────────────────────────────────────────────────────────────
# Use a long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
